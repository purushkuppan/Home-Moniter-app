[Unit]
Description=HomeHub home monitoring service
After=network-online.target
Wants=network-online.target

[Service]
User=homehub
Group=homehub
WorkingDirectory=/opt/homehub
# Optional extra settings as environment variables (NAME=value), readable by root only.
EnvironmentFile=-/etc/homehub/homehub.env
# Secrets as systemd credentials: one root-only file per Spring property. systemd hands them to the
# service in $CREDENTIALS_DIRECTORY, which the app reads through its configtree import.
# The file must exist (setup-hub.sh creates it empty); an empty token leaves the connector idle.
LoadCredential=homeassistant.token:/etc/homehub/credentials/homeassistant.token
# PIN for device controls; an empty file keeps controls disabled.
LoadCredential=homehub.control.pin:/etc/homehub/credentials/homehub.control.pin
# Android alerts through ntfy (#154): the topic and Kudil's publish token, written by setup-ntfy.sh. Empty = ntfy off.
LoadCredential=homehub.ntfy.topic:/etc/homehub/credentials/homehub.ntfy.topic
LoadCredential=homehub.ntfy.token:/etc/homehub/credentials/homehub.ntfy.token
ExecStart=/usr/bin/java -Xms64m -Xmx384m -XX:+UseSerialGC -jar /opt/homehub/current/homehub.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

# Hardening: the service can only write to its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/homehub/data

[Install]
WantedBy=multi-user.target
