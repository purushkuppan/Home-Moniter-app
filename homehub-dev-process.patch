@@ -0,0 +1,50 @@
+name: Release and deploy
+
+# Push a version tag (for example: git tag v0.1.0 && git push origin v0.1.0) to build,
+# publish a GitHub Release, and deploy to the home hub through its self-hosted runner.
+on:
+  push:
+    tags: ['v*']
+
+permissions:
+  contents: write
+
+concurrency:
+  group: deploy-home-hub
+  cancel-in-progress: false
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '25'
+          cache: maven
+      - name: Build and test
+        run: bash ./mvnw -B -ntp verify
+      - name: Prepare the jar
+        run: |
+          mkdir -p dist
+          cp target/homehub-*.jar dist/homehub.jar
+      - name: Create the GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: gh release create "$GITHUB_REF_NAME" dist/homehub.jar --generate-notes --title "$GITHUB_REF_NAME"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: homehub-release
+          path: dist/homehub.jar
+          retention-days: 30
+
+  deploy:
+    needs: build
+    runs-on: [self-hosted, linux, home-hub]
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          name: homehub-release
+      - name: Install, restart and health-check (rolls back on failure)
+        run: sudo /opt/homehub/bin/install-release.sh "$PWD/homehub.jar" "$GITHUB_REF_NAME"
