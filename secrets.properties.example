# HomeHub secrets - EXAMPLE ONLY. Contains placeholders, no real values.
#
# Copy this file OUTSIDE the project and fill in your own values:
#   Windows:      %USERPROFILE%\.homehub\secrets.properties
#   Linux/macOS:  ~/.homehub/secrets.properties
#
# Never commit the real file. Leave a line out (or empty) if you don't use that service.

# Home Assistant base URL and long-lived access token (Profile -> Security -> Long-lived access tokens)
homeassistant.url=http://homeassistant.local:8123
homeassistant.token=REPLACE_WITH_YOUR_HOME_ASSISTANT_TOKEN

# PIN for device controls (at least 4 characters). Without it, controls stay disabled.
# Remove the # and choose your own; don't use something obvious like 1234 or 0000.
#homehub.control.pin=
